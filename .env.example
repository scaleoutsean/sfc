# Docker Images and Versions

VERSITY_S3GW_VERSION=1.9.0
VERSITY_S3GW_IMAGE=docker.io/versity/versitygw:latest
INFLUXDB3_VERSION=3.9.3
INFLUXDB3_BUILD_VERSION=3.9.3
INFLUXDB3_EXPLORER_VERSION=1.6.2
PYTHON_VERSION=3.15.1-alpine-3.24
# https://hub.docker.com/layers/library/python/3.15-alpine3.24/images/sha256-a84283f1b91fb0cd42f88558f221bac04a09bf03648b6c7be41c47e076a15d12
PYTHON_DIGEST=sha256:d44b1254cb92329418d164b22b20d86bbd3869d48e80e09e476531a409a728bb
APSCHEDULER_VERSION=3.11.3
AIOHTTP_VERSION=3.14.4
# At least 12.2 needed to work with internal CAs
GRAFANA_VERSION=12.4-ubuntu

# Network Configuration
# Fixed IPs help with automation of credentials/tokens, best leave as-is to have it "just work"
SFC_SUBNET=172.30.0.0/24
S3_IP=172.30.0.2
INFLUXDB_IP=172.30.0.3
SFC_IP=172.30.0.4
UTILS_IP=172.30.0.5
GRAFANA_IP=172.30.0.6
EXPLORER_IP=172.30.0.7

# Port Configuration
S3_PORT=8443
S3_WEBUI_PORT=9443
INFLUXDB_PORT=8181
GRAFANA_PORT=3000
EXPLORER_PORT=28443

# S3 Configuration for InfluxDB user
# Credentials are supposed to be issued after first stack start
S3_ACCESS_KEY=influxdb3_admin
S3_SECRET_KEY=influxdb3_admin_secret
S3_BUCKET=influxdb
# Enable Web UI and adjust CORS if UI is needed. Change ACCESS/SECRET keys to strong values if you expose the UI.
# Also update ports in docker-compose.yaml if you enable the UI.
S3_WEBUI_ENABLED=false
VGW_CORS_ALLOW_ORIGIN=https://localhost:9443
# S3 API URL the browser uses for WebUI requests (must match host-side port mapping)
VGW_WEBUI_GATEWAYS=https://localhost:8443

# InfluxDB Configuration
# INFLUXDB_ADMIN_TOKEN is supposed to be issued after first start
INFLUXDB_ADMIN_TOKEN=influxdb3_admin_token
INFLUXDB_DB=sfc
INFLUXDB_NODE_ID=node0
# Disable anonymous usage analytics (InfluxDB3 specific)
INFLUXDB3_TELEMETRY_DISABLE_UPLOAD=true

# SFC Configuration
SFC_HI_FREQ=60
SFC_MED_FREQ=300
SFC_LO_FREQ=3600
SFC_EXPERIMENTAL_FREQ=600

# SolidFire Configuration (override these for your environment)
SF_MVIP=192.168.1.34
SF_USERNAME=monitor
SF_PASSWORD=______
# Keep true for security; set to false only as a temporary workaround.
SF_VERIFY_SSL=true

# Grafana Configuration (defaults, override as needed)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=_____
